local function pressKeys(keys)
    for _, key in ipairs(keys) do
        VirtualInputManager:SendKeyPressEvent(true, key, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyPressEvent(false, key, false, game)
        task.wait(0.15)
    end
end

